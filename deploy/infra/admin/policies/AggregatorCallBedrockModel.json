{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseNovaLiteEUProfile",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:GetInferenceProfile"
      ],
      "Resource": "arn:aws:bedrock:eu-central-1:905418096305:inference-profile/eu.amazon.nova-lite-v1:0"
    },
    {
      "Sid": "InvokeNovaLiteThroughEUProfile",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:eu-central-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-north-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-west-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-west-3::foundation-model/amazon.nova-lite-v1:0"
      ],
      "Condition": {
        "StringEquals": {
          "bedrock:InferenceProfileArn": "arn:aws:bedrock:eu-central-1:905418096305:inference-profile/eu.amazon.nova-lite-v1:0"
        }
      }
    }
  ]
}
