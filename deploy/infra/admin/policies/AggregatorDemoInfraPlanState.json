{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyDemoStatePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aggregator-tofu-state-905418096305-eu-central-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["demo/*"]
        }
      }
    },
    {
      "Sid": "ReadDemoState",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::aggregator-tofu-state-905418096305-eu-central-1/demo/tofu.tfstate"
    },
    {
      "Sid": "LockDemoStateForPlan",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::aggregator-tofu-state-905418096305-eu-central-1/demo/tofu.tfstate.tflock"
    }
  ]
}
