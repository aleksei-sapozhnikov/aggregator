{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeDemoEc2ForOpenTofu",
      "Effect": "Allow",
      "Action": ["ec2:Describe*"],
      "Resource": "*"
    },
    {
      "Sid": "InspectDemoRolesAndProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags",
        "iam:GetInstanceProfile",
        "iam:ListInstanceProfilesForRole",
        "iam:ListInstanceProfileTags"
      ],
      "Resource": [
        "arn:aws:iam::905418096305:role/AggregatorDemoEC2Role",
        "arn:aws:iam::905418096305:role/AggregatorDemoK3s*",
        "arn:aws:iam::905418096305:instance-profile/AggregatorDemoEC2Role",
        "arn:aws:iam::905418096305:instance-profile/AggregatorDemoK3s*"
      ]
    },
    {
      "Sid": "InspectApprovedManagedPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions"
      ],
      "Resource": [
        "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
        "arn:aws:iam::905418096305:policy/AggregatorCallBedrockModel",
        "arn:aws:iam::905418096305:policy/AggregatorDemoRoleBoundary"
      ]
    },
    {
      "Sid": "ReadServingDemoSsmDocument",
      "Effect": "Allow",
      "Action": [
        "ssm:GetDocument",
        "ssm:DescribeDocument",
        "ssm:DescribeDocumentPermission",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:eu-central-1:905418096305:document/AggregatorDemoDeploy"
    }
  ]
}
