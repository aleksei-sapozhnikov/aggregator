{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedAggregatorSecurityGroupRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:eu-central-1:905418096305:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "aggregator",
          "aws:RequestTag/Environment": "demo"
        }
      }
    }
  ]
}
