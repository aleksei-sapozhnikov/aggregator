#cloud-config
# Runs only on first boot; rerun configuration through SSM with the installed script.
package_update: true
packages:
  - git
  - python3.12
  - python3.12-pip
write_files:
  - path: /usr/local/sbin/aggregator-node-configure
    owner: root:root
    permissions: '0700'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      umask 077

      REVISION="${1:-dev}"
      if [[ "$REVISION" != "dev" && ! "$REVISION" =~ ^[a-f0-9]{40}$ ]]; then
        echo "Expected dev or a full lowercase Git commit SHA" >&2
        exit 2
      fi

      exec 9>/run/lock/aggregator-node-configure.lock
      flock -n 9 || { echo "Configuration is already running" >&2; exit 1; }
      exec > >(tee -a /var/log/aggregator-node-configure.log) 2>&1

      REPO_DIR=/opt/aggregator-node/repo
      ANSIBLE_ENV=/opt/aggregator-ansible
      REPO_URL=https://github.com/aleksei-sapozhnikov/aggregator.git

      echo "Configuring Aggregator node from $REVISION"
      mkdir -p /opt/aggregator-node
      if [[ ! -d "$REPO_DIR/.git" ]]; then
        git clone --depth 1 --branch dev --no-checkout "$REPO_URL" "$REPO_DIR"
      fi
      git -C "$REPO_DIR" fetch --depth 1 origin "$REVISION"
      git -C "$REPO_DIR" checkout --force --detach FETCH_HEAD

      if [[ ! -x "$ANSIBLE_ENV/bin/ansible-playbook" ]]; then
        python3.12 -m venv "$ANSIBLE_ENV"
        "$ANSIBLE_ENV/bin/python" -m pip install --disable-pip-version-check --no-input ansible-core==2.21.0
      fi

      cd "$REPO_DIR/deploy/ansible"
      "$ANSIBLE_ENV/bin/ansible-playbook" --inventory localhost, --connection local site.yml
      mkdir -p /var/lib/aggregator-node
      git -C "$REPO_DIR" rev-parse HEAD > /var/lib/aggregator-node/last-configured-revision
      echo "Node configuration completed"
runcmd:
  - [ /usr/local/sbin/aggregator-node-configure, "${bootstrap_git_ref}" ]
