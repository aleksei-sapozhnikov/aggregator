{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunApprovedScriptDocumentOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:eu-central-1::document/AWS-RunShellScript"
    },
    {
      "Sid": "TargetOnlyAggregatorK3s",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:eu-central-1:905418096305:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "aggregator",
          "ssm:resourceTag/Environment": "demo",
          "ssm:resourceTag/Name": "aggregator-demo-k3s"
        }
      }
    },
    {
      "Sid": "ReadCommandAndConnectionStatus",
      "Effect": "Allow",
      "Action": [
        "ssm:GetConnectionStatus",
        "ssm:GetCommandInvocation"
      ],
      "Resource": "*"
    }
  ]
}
