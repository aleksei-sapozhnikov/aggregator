# Argo CD reads published manifests from the independent protected GitOps branch.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: aggregator-demo
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/aleksei-sapozhnikov/aggregator.git
    targetRevision: deploy/demo-gitops
    path: deploy/k8s-live
  destination:
    server: https://kubernetes.default.svc
    namespace: aggregator
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - PruneLast=true
