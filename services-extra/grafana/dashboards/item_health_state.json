          "editorMode": "code",
          "exemplar": false,
          "expr": "catalog_item_state{item_id=~\"${item_id:regex}\"} and on() ((vector(${items}) == 1) or (vector(${items}) == 2))",
          "hide": false,
          "instant": false,
          "legendFormat": "\u25CF\u21BA {{item_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(\n  (\n    (catalog_item_signal_state{item_id=~\"${item_id:regex}\"} and on() (vector(${show}) == 0))\n    or (\n      catalog_item_signal_state{item_id=~\"${item_id:regex}\"}\n      and on(item_id,signal_id,signal_source) (min_over_time(catalog_item_signal_state{item_id=~\"${item_id:regex}\"}[$__range] @ end()) < 1)\n      and on() (vector(${show}) == 1)\n    )\n  )\n  and on() ((vector(${signals}) == 1) or (vector(${signals}) == 2))\n)",
          "legendFormat": "\u200b\u25B6\u21BA {{signal_name}}",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(\n  (catalog_item_own_state{item_id=~\"${deps:regex}\"} and on() (vector(${show}) == 0))\n  or (catalog_item_own_state{item_id=~\"${deps:regex}\"} and on(item_id) (min_over_time(catalog_item_own_state{item_id=~\"${deps:regex}\"}[$__range] @ end()) < 1) and on() (vector(${show}) == 1))\n) and on() ((vector(${items}) == 2) or (vector(${items}) == 3))",
          "legendFormat": "\u200c\u25CF\u21B3 {{item_name}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(\n  (\n    (catalog_item_signal_state{item_id=~\"${deps:regex}\"} and on() (vector(${show}) == 0))\n    or (\n      catalog_item_signal_state{item_id=~\"${deps:regex}\"}\n      and on(item_id,signal_id,signal_source) (min_over_time(catalog_item_signal_state{item_id=~\"${deps:regex}\"}[$__range] @ end()) < 1)\n      and on() (vector(${show}) == 1)\n    )\n  )\n  and on() ((vector(${signals}) == 2) or (vector(${signals}) == 3))\n)",
          "legendFormat": "\u200d\u25B6\u21B3 {{signal_name}}",
          "range": true,
          "refId": "D"
        }
      ],
